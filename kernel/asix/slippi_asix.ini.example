# Automatic router configuration. This file is optional: no file means DHCP.
dhcp=1

# To use a static address instead, replace the line above with all of:
# ip=192.168.1.250
# netmask=255.255.255.0
# gateway=192.168.1.1
# dns=192.168.1.1
# Choose an unused address and the actual router subnet.

# DHCP-first static fallback is opt-in; see slippi_asix.fallback.ini.example.
